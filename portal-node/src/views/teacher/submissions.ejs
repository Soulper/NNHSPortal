<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/app_head', { title: 'School Portal' }) %>
</head>
<body>

<%- include('../partials/navbar', { page: 'submissions', unread: 0, chip_role: chip_role, chip_ini: chip_ini }) %>

<div class="container mt-4">
    <% if (flash) { %>
        <div class="alert alert-<%= flash_type %> alert-dismissible fade show" role="alert"><%= flash %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <% if (!assign) { %>
        <div class="alert alert-danger">Assignment not found.</div>
    <% } else { %>
    <div class="page-header">
        <div>
            <a class="small d-inline-block mb-1" href="dashboard.php?page=class&id=<%= Number(assign.class_id) %>&tab=assignments">&larr; Back to Assignments</a>
            <h4 class="page-title"><%= assign.title %></h4>
            <p class="page-subtitle"><%= assign.subject %> &middot; <%= assign.section %><% if (Number(assign.requires_file || 0) !== 0) { %> &middot; File submission required<% } %></p>
        </div>
        <div class="d-flex gap-2">
            <form method="POST" style="display:inline;">
                <input type="hidden" name="action" value="download_all_submissions">
                <input type="hidden" name="assignment_id" value="<%= assignment_id %>">
                <button type="submit" class="btn btn-sm btn-outline-success">Download all (.zip)</button>
            </form>
        </div>
    </div>

    <% if (!subs.length) { %>
        <div class="alert alert-info">No submissions yet.</div>
    <% } else { %>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Student</th><th>Submitted</th><th>File</th><th>Score</th><th>Feedback</th><th></th></tr></thead>
            <tbody>
            <% subs.forEach((sub) => { const form_id = 'gradeform_' + Number(sub.id); %>
                <tr>
                    <td><%= sub.full_name %><% if (Number(sub.is_late || 0) !== 0) { %> <span class="badge bg-warning text-dark">Late</span><% } %></td>
                    <td><small><%- sub.submitted_at %></small></td>
                    <td><% if (sub.file_url) { %><a href="download.php?f=<%= encodeURIComponent(sub.file_url) %>" target="_blank" class="small"><%= sub.original_name || 'View File' %></a><% } else { %><span class="text-muted small">No file</span><% } %></td>
                    <td><input type="number" step="0.01" name="score" form="<%= form_id %>" class="form-control form-control-sm" style="width:70px;" value="<%= sub.score ?? '' %>"></td>
                    <td><input type="text" name="feedback" form="<%= form_id %>" class="form-control form-control-sm" style="width:150px;" value="<%= sub.feedback ?? '' %>"></td>
                    <td><button type="submit" form="<%= form_id %>" class="btn btn-sm btn-success">Grade</button></td>
                </tr>
            <% }); %>
            </tbody>
        </table>
    </div>
    <% subs.forEach((sub) => { %>
        <form method="POST" id="gradeform_<%= Number(sub.id) %>" class="d-none">
            <input type="hidden" name="action" value="grade_submission">
            <input type="hidden" name="submission_id" value="<%= Number(sub.id) %>">
        </form>
    <% }); %>
    <% } %>

    <% if (typeof missing !== 'undefined' && missing && missing.length) { %>
        <div class="card mt-3"><div class="card-header">Not yet submitted (<%= missing.length %>)</div><div class="card-body py-2">
        <% missing.forEach((m) => { %>
            <span class="badge bg-light text-dark border me-1 mb-1"><%= m.full_name %></span>
        <% }); %>
        </div></div>
    <% } %>
    <% } %>
</div>

<%- include('../partials/footer') %>
</body>
</html>
