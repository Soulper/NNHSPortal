<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/app_head', { title: 'School Portal' }) %>
</head>
<body>

<%- include('../partials/navbar', { page: 'sf9', unread: 0, chip_role: chip_role, chip_ini: chip_ini }) %>

<div class="container mt-4">
    <% if (flash) { %>
        <div class="alert alert-<%= flash_type %> alert-dismissible fade show" role="alert"><%= flash %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <% if (!cls) { %>
        <div class="alert alert-danger">Class not found.</div>
    <% } else if (error === 'advisory') { %>
        <div class="alert alert-danger">SF9 report cards are generated by the section adviser only. This is not your advisory class.</div>
    <% } else if (error === 'no_year') { %>
        <div class="alert alert-warning">Link this class to an academic year first (Settings) to print SF9s.</div>
    <% } else { %>
    <div class="page-header">
        <div>
            <a class="small d-inline-block mb-1" href="dashboard.php?page=grades&id=<%= class_id %>">&larr; Back to Grades</a>
            <h4 class="page-title">SF9 Report Cards</h4>
            <p class="page-subtitle"><%= cls.subject %> &middot; <%= cls.section %> &middot; SY <%= cls.year_label ?? '' %></p>
        </div>
    </div>
    <div class="alert alert-info small">
        Each download fills the official SF9 template with the student's <strong>released</strong> Term Grades,
        final grade per subject, remarks and the general average - ready to print. Unreleased terms stay blank.
    </div>

    <% if (!roster.length) { %>
        <div class="alert alert-info">No students enrolled.</div>
    <% } else { %>
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Student No.</th><th>Name</th><th class="text-end">SF9</th></tr></thead>
                    <tbody>
                    <% roster.forEach((s) => { %>
                        <tr>
                            <td><%= s.student_number %></td>
                            <td><%= s.full_name %></td>
                            <td class="text-end">
                                <form method="POST" class="d-inline">
                                    <%- csrf_field %>
                                    <input type="hidden" name="action" value="export_sf9">
                                    <input type="hidden" name="class_id" value="<%= class_id %>">
                                    <input type="hidden" name="student_id" value="<%= Number(s.id) %>">
                                    <button type="submit" class="btn btn-sm btn-brand">Download SF9</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
    <% } %>
</div>

<%- include('../partials/footer') %>
</body>
</html>
