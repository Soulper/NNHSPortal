<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/app_head', { title: 'School Portal' }) %>
</head>
<body>

<%- include('../partials/navbar', { page: 'create_class', unread: 0, chip_role: chip_role, chip_ini: chip_ini }) %>

<div class="container mt-4">
    <% if (flash) { %>
        <div class="alert alert-<%= flash_type %> alert-dismissible fade show" role="alert"><%= flash %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h4 class="page-title mb-1">Create New Class</h4>
                    <form method="POST">
                        <input type="hidden" name="action" value="create_class">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Subject</label>
                                <input type="text" name="subject" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Section</label>
                                <input type="text" name="section" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">School Year</label>
                                <input type="text" name="school_year" class="form-control" placeholder="e.g. 2026-2027" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Academic Year (terms)</label>
                                <select name="academic_year_id" class="form-select">
                                    <% years.forEach((y) => { %>
                                        <option value="<%= Number(y.id) %>" <%= Number(y.is_active || 0) !== 0 ? 'selected' : '' %>><%= y.label %><%= Number(y.is_active || 0) !== 0 ? ' (current)' : '' %></option>
                                    <% }); %>
                                    <% if (!years.length) { %><option value="">No academic years set up</option><% } %>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Description (optional)</label>
                                <textarea name="description" class="form-control" rows="1"></textarea>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-brand">Create Class</button>
                            <a href="dashboard.php" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
</body>
</html>
