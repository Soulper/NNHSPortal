# ---- Database (required) ----
# Local development: a plain SQLite file (created + seeded automatically).
# DATABASE_URL=file:./data/school_portal.db
# Production (Vercel): a Turso database (SQLite-compatible, free tier).
# turso db create student-portal
# turso db show student-portal --url
# turso db tokens create student-portal
DATABASE_URL=libsql://your-db.turso.io
DATABASE_TOKEN=eyJhbGciOi...

# ---- Sessions (required in production) ----
# Any long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- File uploads (optional) ----
# Set automatically by Vercel when you connect Blob storage (see README).
# BLOB_READ_WRITE_TOKEN=
# Upload size cap in MB. Vercel caps request bodies at ~4.5MB.
# UPLOAD_MAX_MB=4

# ---- Misc (optional) ----
# APP_URL=https://your-app.vercel.app
